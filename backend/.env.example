# Copia este archivo a .env y ajusta los valores. NUNCA subas .env a git.
APP_NAME=SECOP Intelligence API
APP_VERSION=0.1.0
API_PREFIX=/api/v1

# development | testing | production
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Obligatoria en producción (mín. 32 caracteres). Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Lista JSON de orígenes permitidos (frontend)
CORS_ORIGINS=["http://localhost:3000"]

SECOP_API_BASE_URL=https://www.datos.gov.co/resource
SECOP_API_TIMEOUT=30
# Opcional: token de app de Socrata (https://data.socrata.com/profile/edit/developer_settings)
SECOP_APP_TOKEN=
# SECOP II - Procesos de Contratación
SECOP_PROCESOS_DATASET=p6dx-8zbt
SECOP_MAX_RETRIES=3
SECOP_CACHE_TTL_SECONDS=300
# Vacío = exigir token solo en producción. true/false para forzar.
SECOP_REQUIRE_AUTH=

AI_PROVIDER=none
AI_API_KEY=
